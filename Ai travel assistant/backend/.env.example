# TravelIQ Backend Environment Configuration Template
# Copy this file to .env and provide strong, unique secrets for production.
# NEVER commit .env to version control.

# Application Server
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=traveliq
DB_USER=traveliq_app
DB_PASSWORD=your_strong_database_password_here

# JWT Authentication Secrets (Generate with `openssl rand -hex 32`)
JWT_SECRET=your_jwt_signing_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here

# Data Encryption at Rest (32-byte hex key for sensitive PII encryption)
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# Service-to-Service Internal Communication (Between Express and FastAPI)
INTERNAL_SERVICE_KEY=your_internal_service_shared_secret_here
AI_SERVICE_URL=http://127.0.0.1:8000

# Administrator Controlled Provisioning Token (Required for initial admin registration)
ADMIN_PROVISIONING_TOKEN=your_one_time_admin_bootstrap_token_here

# n8n Automation Webhook Authentication
N8N_WEBHOOK_SECRET=your_n8n_inbound_webhook_secret_here

# Anti-Scraping / Bot Telemetry
CLIENT_SHIELD_SECRET=your_client_telemetry_salt_here
DISABLE_ANTI_SCRAPING=false

# Allowed Frontend Origins (CORS)
FRONTEND_URL=http://localhost:5173

# External AI Provider (Google Gemini) - API key kept server-side only
GEMINI_API_KEY=your_google_gemini_api_key_here
