# TravelIQ AI Services (FastAPI) Environment Configuration Template
# Copy this file to .env and configure appropriate server-side credentials.
# NEVER commit .env to version control.

# Service Server
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Internal Service-to-Service Secret Authentication (Must match Express backend)
INTERNAL_SERVICE_KEY=your_internal_service_shared_secret_here

# MySQL Connection (Optional: Used for loading model metrics directly into database)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=traveliq
DB_USER=traveliq_app
DB_PASSWORD=your_strong_database_password_here

# Allowed Frontend Origins (CORS allowlist)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000

# Google Gemini API Key (Used server-side for RAG reasoning and travel explanations)
GEMINI_API_KEY=your_google_gemini_api_key_here
