# TravelIQ Root Docker Compose Environment Template
# Copy this file to .env in the "Ai travel assistant" root directory before running docker-compose.

# Database
DB_NAME=traveliq
DB_USER=traveliq_app
DB_PASSWORD=your_strong_db_password_2026
DB_ROOT_PASSWORD=your_strong_mysql_root_password_2026

# Backend Secrets
JWT_SECRET=your_jwt_signing_secret_min_32_characters_long_2026
INTERNAL_SERVICE_KEY=your_internal_service_key_for_fastapi_and_express
CLIENT_SHIELD_SECRET=your_client_shield_salt_key_2026
N8N_WEBHOOK_SECRET=your_n8n_inbound_webhook_secret_2026
ADMIN_PROVISIONING_TOKEN=your_admin_provisioning_bootstrap_token_2026

# AI Integration
GEMINI_API_KEY=your_google_gemini_api_key_here
